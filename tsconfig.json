{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": false,
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "lib": ["ES2022"]
  },
  "exclude": ["dist", ".expo"]
}
